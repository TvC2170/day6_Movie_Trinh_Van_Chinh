@model IEnumerable<Movies.Models.Genre>

@{
    ViewData["Title"] = "Genres";
}

<h1>Genres</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Genre</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Genre</th>
            <th>Movies</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                <td>@genre.Movies.Count</td>
                <td><a asp-action="Details" asp-route-id="@genre.Id">View movies</a></td>
            </tr>
        }
    </tbody>
</table>
