@model Movies.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>
        <dt class="col-sm-2">Release date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReleaseDate)</dd>
        <dt class="col-sm-2">Duration</dt>
        <dd class="col-sm-10">@Model.Duration.Hour hours @Model.Duration.Minute minutes</dd>
        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Genre.Name)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
